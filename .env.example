# Copy to .env.local for local development. Never commit real values.
# In Aiven Runtime, set these as runtime secrets/environment variables (raw values, no quotes).

# Aiven PostgreSQL: service URI (postgres://user:password@host:port/defaultdb).
# Locally use AIVEN_DATABASE_URL; in Aiven Runtime the connected lotara-pg service provides DATABASE_URL.
# TLS parameters such as ?sslmode=require are ignored; the app always verifies the server certificate.
AIVEN_DATABASE_URL=
# Project CA certificate: base64-encoded PEM (Runtime) or a local file path (development).
AIVEN_CA_CERT_BASE64=
AIVEN_CA_CERT_PATH=certs/aiven-ca.pem

# Direct Anthropic API (no gateway). Model/effort are optional overrides.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Demo login and signed kitchen links: generate with `npm run setup:secrets`
# (hash format scrypt:<salt>:<hash>, safe in .env files).
DEMO_ADMIN_PASSWORD_HASH=
SESSION_SECRET=
PARTICIPANT_TOKEN_SECRET=

# Optional: tenant used by this server (browser tests use e2e).
# DEMO_TENANT_ID=demo

# Deferred integrations (not used yet): ELEVENLABS_API_KEY, ELEVENLABS_AGENT_ID, ELEVENLABS_WEBHOOK_SECRET
