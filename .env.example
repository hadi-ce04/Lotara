# Copy to .env.local for local development. Never commit real values.
# In Aiven Runtime, set these as runtime secrets/environment variables.

# Aiven PostgreSQL: service URI from the Aiven console (postgres://user:password@host:port/defaultdb).
# TLS parameters such as ?sslmode=require are ignored; the app always verifies the server certificate.
# In Aiven Runtime, a connected PostgreSQL service may provide DATABASE_URL instead; either name works.
AIVEN_DATABASE_URL=
# Project CA certificate, base64-encoded PEM (required in production).
AIVEN_CA_CERT_BASE64=
# Local alternative to the base64 value: path to the PEM file, e.g. certs/aiven-ca.pem
AIVEN_CA_CERT_PATH=

# Later milestones
AI_GATEWAY_API_KEY=
MODEL_ID=anthropic/claude-sonnet-4.6
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
APP_BASE_URL=
DEMO_ADMIN_PASSWORD_HASH=
SESSION_SECRET=
PARTICIPANT_TOKEN_SECRET=
